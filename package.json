{
  "name": "@agent-relay/agent-token-optimization-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local hook tooling that preselects focused repository context for coding agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bethvourc/agent-token-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/bethvourc/agent-token-optimizer/issues"
  },
  "homepage": "https://github.com/bethvourc/agent-token-optimizer#readme",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1"
    }
  },
  "scripts": {
    "ato": "node packages/cli/dist/index.js",
    "build": "tsc -b --pretty false && node scripts/build/patch-esm-imports.mjs",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm public:check",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "pnpm --filter @agent-relay/agent-token-optimization-benchmarks benchmark",
    "eval:live": "pnpm build && node packages/benchmarks/dist/live-cli.js",
    "eval:report": "pnpm --filter @agent-relay/agent-token-optimization-benchmarks report",
    "public:check": "node scripts/security/public-readiness.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "security:sbom": "node scripts/security/generate-sbom.mjs",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/sql.js": "^1.4.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  }
}
